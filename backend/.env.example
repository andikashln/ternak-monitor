# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ternak_monitor

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# CORS
CORS_ORIGIN=http://localhost:5173,http://192.168.1.100:5173

# Development-only login (ignored when NODE_ENV=production)
DEMO_AUTH_ENABLED=true
DEMO_USER_EMAIL=owner@ternak.local
DEMO_USER_PASSWORD=change_this_local_password
DEMO_USER_NAME=Owner Sapi Papi Farm
DEMO_USER_ROLE=OWNER

# Creates the first OWNER once when PostgreSQL is empty/configured
BOOTSTRAP_OWNER_EMAIL=owner@your-company.com
BOOTSTRAP_OWNER_PASSWORD=change_this_strong_password
BOOTSTRAP_OWNER_NAME=Owner Sapi Papi Farm
